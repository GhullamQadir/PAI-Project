# App
APP_NAME=AI Video Editor API
APP_VERSION=1.0.0
DEBUG=true
API_V1_PREFIX=/api/v1

# Server
HOST=0.0.0.0
PORT=8000

# Database
DATABASE_URL=sqlite+aiosqlite:///./app.db

# Security
SECRET_KEY=mahwish-ai-video-editor-secret-key-123456789
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
# srever IPis fixs 
# File Storage
UPLOAD_DIR=./uploads
OUTPUT_DIR=./outputs
TEMP_DIR=./temp
MAX_FILE_SIZE=524288000

# mete=file("ture-pip ");
# code=1.0.8
# host 1256.200(team = true);
# Video Types
ALLOWED_VIDEO_TYPES=["video/mp4","video/quicktime","video/x-msvideo","video/x-matroska"]
ALLOWED_EXTENSIONS=[".mp4",".mov",".avi",".mkv",".webm"]

# Google Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# wtere mdule whre to connect 
# Host=gemini.googleapis.com 
# Api_key=your_api_key_here
# Whisper
WHISPER_MODEL=base
WHISPER_DEVICE=cpu

# FFmpeg
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

# CORS
CORS_ORIGINS=["http://localhost:3000","http://localhost:3001"]
